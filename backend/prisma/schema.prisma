generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
  SUPPORT
  FLEET_MANAGER
  CORPORATE_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING
}

enum DisabilityType {
  NONE
  VISUAL
  HEARING
  MOBILITY
  COGNITIVE
  MULTIPLE
}

model User {
  id            String    @id @default(uuid())
  phone         String    @unique
  email         String?   @unique
  passwordHash  String
  role          Role      @default(PASSENGER)
  status        UserStatus @default(ACTIVE)
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  passengerProfile PassengerProfile?
  deviceSessions   DeviceSession[]
  userConsents     UserConsent[]

  @@map("users")
}

model PassengerProfile {
  id                   String         @id @default(uuid())
  userId               String         @unique
  firstName            String
  lastName             String
  photoUrl             String?
  
  // Accessibility Requirements
  requiresAccessibleTier Boolean      @default(false)
  disabilityType       DisabilityType @default(NONE)
  prefersTextOnly      Boolean        @default(false)
  prefersVoice         Boolean        @default(false)
  requiresScreenReader Boolean        @default(false)
  requiresTextToSpeech Boolean        @default(false)
  requiresBraille      Boolean        @default(false)
  textScale            Float          @default(1.0)
  highContrast         Boolean        @default(false)
  darkMode             Boolean        @default(false)
  preferredLanguage    String         @default("en")
  
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passenger_profiles")
}

model DeviceSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  deviceToken  String?  // For push notifications
  deviceName   String?
  ipAddress    String?
  userAgent    String?
  isValid      Boolean  @default(true)
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("device_sessions")
}

model UserConsent {
  id                    String   @id @default(uuid())
  userId                String
  termsAccepted         Boolean
  termsVersion          String
  privacyPolicyAccepted Boolean
  privacyPolicyVersion  String
  popiaConsent          Boolean  // Explicit POPIA data processing consent
  marketingConsent      Boolean  @default(false)
  ipAddress             String?
  createdAt             DateTime @default(now())

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_consents")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entityId  String?
  entity    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// Add to existing User model:
// driverProfile DriverProfile?

enum DriverStatus {
  OFFLINE
  ONLINE
  IN_TRIP
  SUSPENDED
}

enum DocumentType {
  ID_DOCUMENT
  DRIVERS_LICENSE
  PDP
  VEHICLE_REGISTRATION
  OPERATING_PERMIT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model DriverProfile {
  id                    String       @id @default(uuid())
  userId                String       @unique
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber         String       @unique
  isAccessibleCertified Boolean      @default(false)
  status                DriverStatus @default(OFFLINE)
  rating                Decimal      @default(5.0) @db.Decimal(3, 2)
  totalTrips            Int          @default(0)

  vehicles              Vehicle[]
  documents             DriverDocument[]
  location              DriverLocation?

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("driver_profiles")
}

model Vehicle {
  id                     String             @id @default(uuid())
  driverId               String
  driver                 DriverProfile      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  make                   String
  model                  String
  year                   Int
  registration           String             @unique
  color                  String
  vehicleType            String             // e.g., SEDAN, SUV, HATCHBACK
  seatingCapacity        Int
  bootCapacityLitres     Int
  isWAV                  Boolean            @default(false)
  wheelchairCapacity     Int                @default(0)
  accessibilityEquipment String[]           // e.g., ["RAMP", "LIFT", "SWIVEL_SEAT"]
  verificationStatus     VerificationStatus @default(PENDING)

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@map("vehicles")
}

model DriverDocument {
  id                  String             @id @default(uuid())
  driverId            String
  driver              DriverProfile      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type                DocumentType
  fileUrl             String
  verificationStatus  VerificationStatus @default(PENDING)
  expiryDate          DateTime?
  rejectionReason     String?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("driver_documents")
}

model DriverLocation {
  driverId            String        @id
  driver              DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  latitude            Float
  longitude           Float
  heading             Float?
  speed               Float?
  accuracy            Float?
  
  // PostGIS Geography type for optimized spatial queries (SRID 4326)
  geom                Unsupported("geography(Point, 4326)")?

  updatedAt           DateTime      @default(now())

  @@map("driver_locations")
}

enum RideStatus {
  REQUESTED
  TOKEN_SENT
  VERIFIED
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  ARRIVED
  IN_TRIP
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CARD
  CASH
  WALLET
  CORPORATE
}

model Ride {
  id                     String        @id @default(uuid())
  passengerId            String
  driverId               String?
  vehicleId              String?
  
  status                 RideStatus    @default(REQUESTED)
  paymentMethod          PaymentMethod @default(CASH)
  
  // Locations (stored as JSON for historical context, active queries use PostGIS)
  pickupLat              Float
  pickupLng              Float
  pickupAddress          String
  destinationLat         Float
  destinationLng         Float
  destinationAddress     String
  
  // Accessibility & Empathy Rules
  requiresAccessibleTier Boolean       @default(false)
  gracePeriodMinutes     Int           @default(3) // Empathy rule: 12 if accessible, else 3
  
  // Financials
  estimatedFare          Decimal       @db.Decimal(10, 2)
  finalFare              Decimal?      @db.Decimal(10, 2)
  
  // Timestamps
  requestedAt            DateTime      @default(now())
  acceptedAt             DateTime?
  arrivedAt              DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  cancelledBy            String?       // ID of user or "SYSTEM"
  cancellationReason     String?

  passenger              User          @relation(fields: [passengerId], references: [id])
  driver                 DriverProfile? @relation(fields: [driverId], references: [id])
  vehicle                Vehicle?      @relation(fields: [vehicleId], references: [id])

  @@index([passengerId])
  @@index([driverId])
  @@index([status])
  @@map("rides")
}
